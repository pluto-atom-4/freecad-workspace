#VRML_SIM R2025a utf8

# copy of servo_wheel_dof.wbt for the ctrl-wheel relay sim (issues #447/#458, parent #446).
# The wheel is driven by the ctrl_wheel controller with setVelocity.
# SIM ONLY. No balance claim.
#
# Device names (exact, case-sensitive -- the controller looks these up):
#   RotationalMotor name: "wheel_motor"
#   PositionSensor  name: "wheel_sensor"
#
# Frame: ENU (x East, y North, z Up).
# A Webots Cylinder's axis is local Z, so do NOT add a `rotation` to the wheel
# Solid. HingeJoint anchor and wheel translation must stay identical
# (0 0 0.026 = body face 0.02 + half the wheel height 0.006).
# The Robot has no Physics node; the wheel endPoint does (mass 0.05).
# The Robot has the `supervisor` field set to TRUE (unchanged from the copied world).

WorldInfo {
  info [
    "ctrl-wheel (issues #447/#458): idealised velocity-driven wheel (generic RotationalMotor, no servo model) with the ctrl_wheel controller."
  ]
  title "ctrl_wheel"
  coordinateSystem "ENU"
  basicTimeStep 16
}

Viewpoint {
  orientation -0.3 0.3 0.9 1.2
  position -0.25 -0.35 0.35
}

Background {
  skyColor [0.6 0.75 0.95]
}

DirectionalLight {
  direction -0.5 -0.5 -1.0
  intensity 1.0
  ambientIntensity 0.4
}

Solid {
  translation 0 0 -0.01
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.75 0.75 0.75
        }
      }
      geometry Box {
        size 2.0 2.0 0.02
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 2.0 2.0 0.02
  }
}

DEF CTRL_WHEEL Robot {
  translation 0 0 0.03
  rotation 1 0 0 1.57079633
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.15 0.15 0.15
        }
      }
      geometry Box {
        size 0.04 0.02 0.04
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0 0 0.026
      }
      # maxVelocity and maxTorque are not set here; owner reads the Webots defaults then sets them (issue #458)
      device [
        RotationalMotor {
          name "wheel_motor"
        }
        PositionSensor {
          name "wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0 0.026
        children [
          Transform {
            translation 0.024 0 0
            children [
              Shape {
                appearance Appearance {
                  material Material {
                    diffuseColor 1 0 0
                  }
                }
                geometry Box {
                  size 0.006 0.006 0.014
                }
              }
            ]
          }
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.05 0.05 0.05
              }
            }
            geometry Cylinder {
              radius 0.03
              height 0.012
            }
          }
        ]
        name "wheel"
        boundingObject Cylinder {
          radius 0.03
          height 0.012
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
  ]
  name "ctrl_wheel"
  controller "ctrl_wheel"
  supervisor TRUE
}
