          density -1
          mass 0.05
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0 0 -0.050
      }
      device [
        RotationalMotor {
          name "wheel_motor_right"
          maxVelocity 3.5
          maxTorque 1e-3
        }
