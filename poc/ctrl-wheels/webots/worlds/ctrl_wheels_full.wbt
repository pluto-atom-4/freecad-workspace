#VRML_SIM R2025a utf8

# EXPERIMENT, sim only, not the main world. Copy of ctrl_wheels.wbt for freecad-workspace #545,
# which tests #544 (boxes look displaced from the driven wheels, cause unverified). No balance claim.
# Direction, observations and motor-limit derivations: see the header of ctrl_wheels.wbt.
#
# WHY (mass, centre of mass, skid size and 0.5 mm clearance are GUESSES, none measured):
# - Robot is the physics root: in the main world only the wheels have physics under a kinematic
#   Robot, which Webots warns about and which may let wheels and boxes move apart (#544).
# - boundingObject is a Group of the two body Boxes plus two passive skids: a physics Robot needs
#   one, and the skids are meant to keep the free body from tipping onto the axle (untested).
# - centerOfMass 2 mm below the axle (local +y): meant to keep the body hanging level.
# - contactMaterial body with friction 0 against default: so the skids slide and add no drag.
#   The wheels keep the default material. Whether Webots applies it so is untested.
#
# HOW TO USE (human, in Webots; nothing was run): command +1.0 and -1.0 rad/s, 6 s each. Pass if
# wheel local z stays 0.0500 and -0.0500 (the box-to-wheel offset is constant). Report the Robot
# translation and rotation in #545.
#
# HAZARDS:
# - Robot rotation is -90 degrees about x: local +z is the world +y axle, local +y is world DOWN.
# - Per side, HingeJoint anchor and endPoint translation must stay identical (0.050 or -0.050 =
#   inner face 0.044 + half wheel height 0.006). Do not rotate a wheel Solid (Cylinder axis is z).
# - Wheel inner face touches the body box face (0.044, no clearance): contact is untested.
# - Units rad/s and N.m. The controller clamps to 3.0 rad/s (CLAMP_RAD_S); maxVelocity 3.5 is
#   above it and never limits. maxTorque 1e-3 is owner-chosen, not a servo spec.
# - The robot can roll away and off the 2 m floor.
# - test_ctrl_wheels_world.py pins only the main world, not this file. Device names are exact.
# - Group of bare Boxes and ContactProperties are UNVERIFIED in Webots R2025a.

WorldInfo {
  info [
    "ctrl-wheels EXPERIMENT (freecad-workspace issue #544, part of #533): physics-root copy of the twin world. Two idealised velocity-driven wheels on a free body (generic RotationalMotor, no servo model) for the ctrl_wheels controller. Not the main world. Sim only."
  ]
  title "ctrl_wheels"
  coordinateSystem "ENU"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "body"
      material2 "default"
      coulombFriction [ 0 ]
    }
  ]
}

Viewpoint {
  orientation -0.3 0.3 0.9 1.2
  position -0.25 -0.35 0.35
}

Background {
  skyColor [0.6 0.75 0.95]
}

DirectionalLight {
  direction -0.5 -0.5 -1.0
  intensity 1.0
  ambientIntensity 0.4
}

Solid {
  translation 0 0 -0.01
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.75 0.75 0.75
        }
      }
      geometry Box {
        size 2.0 2.0 0.02
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 2.0 2.0 0.02
  }
}

DEF CTRL_WHEELS Robot {
  translation 0 0 0.03
  rotation 1 0 0 -1.57079633
  children [
    DEF BODY_BOX_LEFT Transform {
      translation 0 0 0.024
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.45 0.20 0.20
            }
          }
          geometry Box {
            size 0.04 0.02 0.04
          }
        }
      ]
    }
    DEF BODY_BOX_RIGHT Transform {
      translation 0 0 -0.024
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.20 0.20 0.45
            }
          }
          geometry Box {
            size 0.04 0.02 0.04
          }
        }
      ]
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0 0 0.050
      }
      device [
        RotationalMotor {
          name "wheel_motor_left"
          maxVelocity 3.5
          maxTorque 1e-3
        }
        PositionSensor {
          name "wheel_sensor_left"
        }
      ]
      endPoint Solid {
        translation 0 0 0.050
        children [
          Transform {
            translation 0.024 0 0
            children [
              Shape {
                appearance Appearance {
                  material Material {
                    diffuseColor 1 0 0
                  }
                }
                geometry Box {
                  size 0.006 0.006 0.014
                }
              }
            ]
          }
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.05 0.05 0.05
              }
            }
            geometry Cylinder {
              radius 0.03
              height 0.012
            }
          }
        ]
        name "wheel_left"
        boundingObject Cylinder {
          radius 0.03
          height 0.012
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0 0 -0.050
      }
      device [
        RotationalMotor {
          name "wheel_motor_right"
          maxVelocity 3.5
          maxTorque 1e-3
        }
        PositionSensor {
          name "wheel_sensor_right"
        }
      ]
      endPoint Solid {
        translation 0 0 -0.050
        children [
          Transform {
            translation 0.024 0 0
            children [
              Shape {
                appearance Appearance {
                  material Material {
                    diffuseColor 0 0 1
                  }
                }
                geometry Box {
                  size 0.006 0.006 0.014
                }
              }
            ]
          }
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.05 0.05 0.05
              }
            }
            geometry Cylinder {
              radius 0.03
              height 0.012
            }
          }
        ]
        name "wheel_right"
        boundingObject Cylinder {
          radius 0.03
          height 0.012
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
  ]
  contactMaterial "body"
  boundingObject Group {
    children [
      Transform {
        translation 0 0 0.024
        children [
          Box {
            size 0.04 0.02 0.04
          }
        ]
      }
      Transform {
        translation 0 0 -0.024
        children [
          Box {
            size 0.04 0.02 0.04
          }
        ]
      }
      Transform {
        translation 0.02 0.0195 0
        children [
          Box {
            size 0.004 0.020 0.004
          }
        ]
      }
      Transform {
        translation -0.02 0.0195 0
        children [
          Box {
            size 0.004 0.020 0.004
          }
        ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.064
    centerOfMass [ 0 0.002 0 ]
  }
  name "ctrl_wheels"
  controller "ctrl_wheels"
  supervisor TRUE
}
