#VRML_SIM R2025a utf8

# Stage 3 world (issue #24) — instantiates the urdf2webots-generated
# TurtlebotPoc PROTO (from urdf/turtlebot3_poc.urdf via
# webots/protos/TurtlebotPoc.proto) with the wheel_articulation_check
# controller attached. Deliberately uses only Webots base nodes (Background,
# DirectionalLight, a plain Solid floor) instead of the TexturedBackground/
# RectangleArena PROTOs, to avoid depending on a live EXTERNPROTO fetch for
# a batch/no-rendering articulation smoke test.

EXTERNPROTO "../protos/TurtlebotPoc.proto"

WorldInfo {
  info [
    "Stage 3 POC world for issue #24 -- FreeCAD -> Webots pipeline spike."
    "Not part of the real project robot; TurtleBot3 Burger used as a public reference model."
  ]
  title "turtlebot3_poc"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.3 0.3 0.9 1.2
  position 0.6 -0.6 0.5
}
Background {
  skyColor [
    0.4 0.7 1.0
  ]
}
DirectionalLight {
  direction 0.3 -0.3 -1
  intensity 1
}
Solid {
  translation 0 0 -0.001
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.6 0.6 0.6
        roughness 1
        metalness 0
      }
      geometry Box {
        size 2 2 0.002
      }
    }
  ]
  boundingObject Box {
    size 2 2 0.002
  }
}
TurtlebotPoc {
  translation 0 0 0.02
  controller "wheel_articulation_check"
}
