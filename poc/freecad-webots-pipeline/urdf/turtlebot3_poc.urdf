<?xml version="1.0" ?>
<!--
  turtlebot3_poc.urdf — Stage 2 POC URDF for issue #24
  (FreeCAD -> Webots pipeline spike)

  Structural copy of the ROBOTIS turtlebot3_burger.urdf fetched by
  ../00_fetch_turtlebot3_assets.sh (pinned SHA recorded in ../NOTICE),
  trimmed to the parts this spike cares about: base_link (root),
  two continuous wheel joints, and the fixed caster. The lds/imu links
  (sensor mounts with no bearing on wheel articulation) are dropped to
  keep the POC minimal.

  Per issue #32: the original ROBOTIS-matching massless base_footprint
  root link + fixed base_joint to base_link were removed. That structure
  left the generated Webots PROTO's Robot node without its own physics/
  boundingObject (both landed one level down, on a nested base_link
  Solid), which Webots implicitly welds to the static world — the
  chassis could spin its wheels but never translate. base_link is now
  the URDF root link directly, so the generated PROTO's Robot node
  itself carries physics/boundingObject.

  Per decision #4 in the issue #24 implementation plan, the <mesh> tags
  below point at the FreeCAD STEP-round-tripped re-exports produced by
  ../freecad/02_roundtrip_check.py (copied into ./meshes/ by that stage's
  workflow — see ../README.md), NOT the pristine vendored STLs in
  ../reference/meshes/. This exercises FreeCAD's own mesh re-export path,
  which is the actual point of the spike.

  This file is hand-maintained for this POC only. It is NOT produced by,
  and does not feed into, issue #9's future urdf_builder.py /
  10_export_urdf.py exporter.
-->
<robot name="turtlebot3_poc">

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <!-- FreeCAD round-tripped re-export (mm mesh, 0.001 scale below
             converts to metres — see FINDINGS.md for the mm<->m note) -->
        <mesh filename="meshes/burger_base_roundtrip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.032 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.143"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.2573504e-01"/>
      <inertia ixx="2.2124416e-03" ixy="-1.2294101e-05" ixz="3.4938785e-05"
               iyy="2.1193702e-03" iyz="-5.0120904e-06" izz="2.0064271e-03"/>
    </inertial>
  </link>

  <!-- Wheel joints: type="continuous" (unbounded rotation, appropriate for
       drive wheels), axis="0 0 1" in the JOINT's own rotated frame. The
       origin rpy="-1.57 0 0" (-90 deg about X) is what actually points
       that local Z axis along the world Y axis, so the wheel spins about
       world Y as expected for a wheel on the robot's left/right side.
       See FINDINGS.md for the full explanation — this is the single
       easiest thing to get backwards when hand-authoring/porting a URDF. -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="meshes/left_tire_roundtrip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.8498940e-02"/>
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.080 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="meshes/right_tire_roundtrip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.8498940e-02"/>
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05"/>
    </inertial>
  </link>

  <!-- Fixed caster: box collision primitive only, deliberately NO visual
       mesh — the real ROBOTIS URDF has none for this link either, so this
       POC does not invent one. -->
  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

</robot>
